# Copy to .env and replace every example secret before starting the stack.
# Use URL/DSN-safe alphanumeric passwords; DB_DSN embeds KORA_DB_PASSWORD.
KORA_MYSQL_ROOT_PASSWORD=replace-with-a-unique-long-secret
KORA_DB_PASSWORD=replace-with-a-different-unique-long-alphanumeric-secret
KORA_ADMIN_EMAIL=admin@example.invalid
KORA_ADMIN_PASSWORD=replace-with-a-unique-long-secret

# Bind the workspace only to loopback behind a TLS-terminating reverse proxy.
KORA_HTTP_BIND=127.0.0.1:8080

# Static per-replica allocation for this dedicated MySQL server. Recalculate
# these values before adding Engine replicas; reserve space for operations.
KORA_DB_SERVER_MAX_CONNECTIONS=160
KORA_DB_SERVER_RESERVED_CONNECTIONS=32
KORA_DB_ENGINE_REPLICAS=1
KORA_DB_CONNECTION_BUDGET=64
KORA_DB_ACTIVE_WORK_BUDGET=16
# Leave waiter values unset to derive them from the per-replica pool/work caps.
# KORA_DB_CONNECTION_WAITERS=128
# KORA_DB_CONNECTION_WAIT_MS=1500
# KORA_DB_ACTIVE_WORK_WAITERS=32
# KORA_DB_ACTIVE_WORK_WAIT_MS=1000
# KORA_DB_SERVER_MAX_HEAVY_JOBS=1

# Process and tenant resource caps (bytes are decimal integers in bytes).
KORA_MAX_RESIDENT_TENANTS=256
KORA_TENANT_ACTIVATION_WAITERS=32
KORA_TENANT_ACTIVATION_WAIT_MS=1500
KORA_ANALYTICS_PROCESS_MAX_QUEUED_BYTES=536870912
KORA_ANALYTICS_MAX_QUEUED_BYTES=67108864
KORA_ANALYTICS_MAX_SUBSCRIBERS=4096
KORA_ANALYTICS_MAX_EVENT_BYTES=1048576
KORA_ASYNC_HOOK_QUEUE_SIZE=1000
KORA_ASYNC_HOOK_MAX_QUEUED_BYTES=67108864
KORA_ASYNC_HOOK_MAX_EVENT_BYTES=1048576
KORA_SCRIPT_MAX_CONCURRENCY=2
KORA_SCRIPT_MAX_WAITERS=4
KORA_SCRIPT_MAX_ACTIVE_TENANTS=256
KORA_SCRIPT_WAIT_MS=1000
KORA_SCRIPT_TIMEOUT_MS=5000
KORA_REALTIME_MAX_STREAMS=128
KORA_SESSION_CACHE_MAX_BYTES=268435456
KORA_UPLOAD_MAX_ACTIVE=4
KORA_UPLOAD_ACTIVE_BUDGET_BYTES=536870912

# Set the public workspace origin for tenant-path sign-in links when users enter
# through one shared app host (for example https://app.example.com). Leave
# unset only when every tenant has a directly routed hostname.
# KORA_PUBLIC_APP_BASE_URL=https://app.example.com

# SMTP is required for magic-link sign-in and administrator invitations.
# Use your mail provider in production. For local testing, point these at a
# Mailpit instance reachable from Engine (host=mailpit in the same Compose
# network, or host.docker.internal when Mailpit runs on the Docker host).
# KORA_SMTP_HOST=mailpit
# KORA_SMTP_PORT=1025
# KORA_SMTP_TLS_MODE=plain
# KORA_SMTP_FROM=no-reply@example.com
# KORA_SMTP_USERNAME=
# KORA_SMTP_PASSWORD=

# Dedicated credential for Cloud-managed channel client issuance/revocation.
# Set the same generated secret as Cloud's KORA_CLOUD_ENGINE_PROVISIONING_TOKEN.
# Keep it separate from management, tenant, and managed-channel credentials.
# KORA_ENGINE_PROVISIONING_TOKEN=replace-with-a-distinct-long-secret

# Optional Cloud management endpoint. Leave unset for Engine-only operation.
# KORA_CLOUD_URL=https://cloud.example.invalid

# Optional: allow a trusted Cloud control plane to manage this Engine.
# Configure these four Engine values together. Use distinct, generated tokens
# for each deployment; configure the same token in Cloud, and ensure deployment
# and allocation references exactly match Cloud's assignment. The allocation
# reference is an operator-owned label for this Engine's dedicated SQL server,
# not a secret or a URL.
# KORA_ENGINE_MANAGEMENT_TOKEN=replace-with-a-distinct-long-secret
# KORA_ENGINE_MANAGEMENT_CALLER_ID=kora-cloud
# Keep this aligned with active directory assignments; use `default` while
# existing tenants still have blank legacy assignments.
# KORA_ENGINE_DEPLOYMENT_ID=default
# KORA_ENGINE_MANAGEMENT_DATABASE_ALLOCATION_REF=mysql-selfhost

# Optional immutable marketplace artifact provider for the Engine-owned
# durable package-activation operation. Keep this bearer token separate from
# KORA_ENGINE_MANAGEMENT_TOKEN, tenant credentials, and managed-channel tokens.
# Both values must be set together; the URL must use HTTPS outside loopback.
# KORA_ENGINE_MANAGEMENT_ARTIFACT_URL=https://cloud.example.invalid
# KORA_ENGINE_MANAGEMENT_ARTIFACT_TOKEN=replace-with-a-distinct-long-secret

# The workspace checkout is expected next to the Engine checkout by default.
# Set this to another path when deploying from a different source layout.
# KORA_UI_SOURCE=../../../kora-studio-mvp
