# Kora development environment variables
# Copy this file to .env and change the values.
# NEVER commit .env with real passwords to version control.

MYSQL_ROOT_PASSWORD=change_me
KORA_CONSOLE_ONBOARDING_ENABLED=false

# Public application origin for emailed sign-in and administrator-invitation
# links when tenants use the shared /s/:site workspace route. Set this to the
# standalone Kora UI origin in the deployment (for example http://localhost:5173
# for local Studio, or your public workspace origin). Leave empty for
# host-routed deployments where every tenant has its own public hostname.
KORA_PUBLIC_APP_BASE_URL=

# Browser origins allowed to call Engine APIs with credentials. Include the
# Cloud customer portal origin for the one-time workspace handoff.
# KORA_CORS_ALLOWED_ORIGINS=https://cloud.kora.example,https://app.kora.example

# SMTP delivers sign-in and administrator-invitation links. For local
# Mailpit, use 127.0.0.1:1025 and plain TLS mode; use provider TLS and
# credentials for a remote SMTP service.
# KORA_SMTP_HOST=127.0.0.1
# KORA_SMTP_PORT=1025
# KORA_SMTP_TLS_MODE=plain
# KORA_SMTP_FROM=no-reply@kora.local
# KORA_SMTP_USERNAME=
# KORA_SMTP_PASSWORD=
# The one secret shared with Cloud (set the same value in Cloud). It replaces the
# separate management, artifact, provisioning, identity, reload, AI gateway and
# events tokens.
KORA_INTEGRATION_TOKEN=replace-with-the-shared-integration-token
# Cloud's private one-time handoff redemption endpoint.
KORA_ENGINE_CLOUD_IDENTITY_URL=http://host.docker.internal:8080/internal/identity/handoff/redeem

# Optional NATS/JetStream event transport. The dead-letter subject is stored by
# the event stream but must lie outside every consumer filter (default
# "<prefix>.>"); the default below is derived from the prefix. Older releases
# used kora.deadletter, which is now rejected at startup: unset it or change it.
# KORA_NATS_SUBJECT_PREFIX=kora
# KORA_NATS_DEAD_LETTER=kora_deadletter
