+/* Kora: reseed Math.random after a snapshot restore (the state is copied with the
+ * snapshot). A zero seed would stick the generator at zero, so it maps to 1. */
+void JS_KoraReseedRandom(JSContext *ctx, uint64_t seed)
+{
+    ctx->random_state = seed ? seed : 1;
+}
